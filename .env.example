# Used only by the scheduled crawler. Never prefix these values with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional crawler tuning.
GMAIL_QUERY=newer_than:2d -in:spam -in:trash
CRAWL_LOOKBACK_HOURS=72

# Public client configuration for the anonymous article intake.
VITE_ARTICLE_SUBMISSION_ENDPOINT=
VITE_TURNSTILE_SITE_KEY=

# Optional loopback-only inspiration adapters; never VITE_ variables.
RAINDROP_TOKEN=
SAVEE_TOKEN=
PINTEREST_TOKEN=
INSPIRATION_DB_PATH=

# Server-side Toolbox update-log delivery (also configure repository secrets).
RESEND_API_KEY=
TOOLBOX_EMAIL_FROM=
TOOLBOX_EMAIL_TO=

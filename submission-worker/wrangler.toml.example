name = "design-daily-article-intake"
main = "index.js"
compatibility_date = "2026-09-21"

[vars]
ALLOWED_ORIGINS = "https://r4ph426.github.io"
GITHUB_REPOSITORY = "r4ph426/design-daily"

# Deploy the binding and migration together with the new Worker code.
[[durable_objects.bindings]]
name = "SUBMISSION_RATE_LIMIT"
class_name = "SubmissionRateLimit"

[[migrations]]
tag = "v1-submission-rate-limit"
new_sqlite_classes = ["SubmissionRateLimit"]

# Store GITHUB_TOKEN and TURNSTILE_SECRET with `wrangler secret put`.

{
  "name": "design-daily",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "vite build --mode pages",
    "crawl": "node scripts/daily-crawl.mjs",
    "crawl:dry": "node scripts/daily-crawl.mjs --dry-run",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:crawler": "node --test tests/crawler.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
